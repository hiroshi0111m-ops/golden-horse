        "location_assertion_id": "qa-location-inside-{{run_id}}"
      },
      "expected_status": 200,
      "expected_fields": {
        "checked_out": true,
        "audit_event_id": "$nonempty"
      }
    },
    {
      "id": "visit_reward_granted",
      "category": "visit_reward",
      "method": "POST",
      "path": "/v1/visit-rewards/finalize",
      "headers": {
        "Idempotency-Key": "qa-reward-{{run_id}}"
      },
      "body": {
