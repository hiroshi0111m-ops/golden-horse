        "member_id": "guest-authority-qa-{{run_id}}",
        "payment_provider": "qa-provider",
        "external_payment_id": "qa-payment-{{run_id}}",
        "payment_status": "paid",
        "paid_at": "2026-10-18T00:00:00Z",
        "refund_status": "not_refunded",
        "actual_use_confirmed": true,
        "check_out_confirmed": true,
        "outside_prohibited_radius_when_gps_enabled": true,
        "configured_delay_elapsed": true,
        "idempotency_key": "qa-reward-{{run_id}}"
      },
      "expected_status": 201,
      "expected_fields": {
        "granted": true,
        "g_ledger_entry_id": "$nonempty",
        "audit_event_id": "$nonempty",
        "reservation_id": "qa-reservation-{{run_id}}",
        "external_payment_id": "qa-payment-{{run_id}}",
        "member_id": "guest-authority-qa-{{run_id}}"
      }
    },
