{
  "schema_version": 1,
  "suite_id": "golden-horse-authority-conformance-v1",
  "requires_isolated_test_environment": true,
  "run_token": "{{run_id}}",
  "payment_connector_fields": [
    "payment_provider",
    "external_payment_id",
    "payment_status",
    "paid_at",
    "refund_status"
  ],
  "cases": [
    {
      "id": "initial_state",
      "category": "authoritative_state",
      "method": "GET",
      "path": "/v1/state/guest-authority-qa-{{run_id}}",
      "expected_status": 200,
      "expected_fields": {
        "member_id": "guest-authority-qa-{{run_id}}",
        "balance_g": 1000,
        "server_revision": 0,
        "state_signature": "$nonempty"
      }
    },
    {
      "id": "bet_accept",
      "category": "idempotent_bet",
      "method": "POST",
      "path": "/v1/bets",
      "headers": {
        "Idempotency-Key": "qa-bet-{{run_id}}"
      },
      "body": {
        "member_id": "guest-authority-qa-{{run_id}}",
        "race_id": "qa-race-001",
        "bet_type": "win",
        "selections": [
          1
        ],
        "stake_g": 5,
        "idempotency_key": "qa-bet-{{run_id}}",
        "client_revision": 0,
        "device_id": "qa-device-{{run_id}}",
        "location_assertion_id": "qa-location-outside-{{run_id}}"
      },
      "expected_status": 201,
      "expected_fields": {
        "accepted": true,
        "balance_g": 995,
        "server_revision": 1,
        "bet_id": "$nonempty",
        "state_signature": "$nonempty",
        "audit_event_id": "$nonempty"
      }
    },
    {
      "id": "bet_duplicate",
      "category": "idempotent_bet",
      "method": "POST",
      "path": "/v1/bets",
      "headers": {
        "Idempotency-Key": "qa-bet-{{run_id}}"
      },
      "body": {
        "member_id": "guest-authority-qa-{{run_id}}",
        "race_id": "qa-race-001",
        "bet_type": "win",
        "selections": [
          1
        ],
        "stake_g": 5,
        "idempotency_key": "qa-bet-{{run_id}}",
        "client_revision": 0,
        "device_id": "qa-device-{{run_id}}",
        "location_assertion_id": "qa-location-outside-{{run_id}}"
      },
      "expected_status": 200,
      "expected_fields": {
        "accepted": true,
        "balance_g": 995,
        "server_revision": 1
      },
      "same_as": {
        "bet_id": "bet_accept.bet_id",
        "state_signature": "bet_accept.state_signature"
      }
    },
    {
      "id": "stale_revision_rejected",
      "category": "revision_rollback",
      "method": "POST",
      "path": "/v1/bets",
      "headers": {
        "Idempotency-Key": "qa-stale-{{run_id}}"
      },
      "body": {
        "member_id": "guest-authority-qa-{{run_id}}",
        "race_id": "qa-race-002",
        "bet_type": "win",
        "selections": [
          2
        ],
        "stake_g": 5,
        "idempotency_key": "qa-stale-{{run_id}}",
        "client_revision": 0,
        "device_id": "qa-device-{{run_id}}",
        "location_assertion_id": "qa-location-outside-{{run_id}}"
      },
      "expected_status": 409,
      "expected_fields": {
        "accepted": false,
        "reject_reason": "stale_revision",
        "balance_g": 995,
        "server_revision": 1,
        "audit_event_id": "$nonempty"
      }
    },
    {
      "id": "inside_radius_bet_rejected",
      "category": "gps_radius",
      "method": "POST",
      "path": "/v1/bets",
      "headers": {
        "Idempotency-Key": "qa-gps-{{run_id}}"
      },
      "body": {
        "member_id": "guest-authority-qa-{{run_id}}",
        "race_id": "qa-race-002",
        "bet_type": "win",
        "selections": [
          2
        ],
        "stake_g": 5,
        "idempotency_key": "qa-gps-{{run_id}}",
        "client_revision": 1,
        "device_id": "qa-device-{{run_id}}",
        "location_assertion_id": "qa-location-inside-{{run_id}}"
      },
      "expected_status": 403,
      "expected_fields": {
        "accepted": false,
        "reject_reason": "inside_prohibited_radius",
        "balance_g": 995,
        "server_revision": 1,
        "audit_event_id": "$nonempty"
      }
    },
    {
      "id": "mock_location_rejected",
      "category": "gps_fraud_detection",
      "method": "POST",
      "path": "/v1/bets",
      "headers": {
        "Idempotency-Key": "qa-mock-location-{{run_id}}"
      },
      "body": {
        "member_id": "guest-authority-qa-{{run_id}}",
        "race_id": "qa-race-002",
        "bet_type": "win",
        "selections": [
          2
        ],
        "stake_g": 5,
        "idempotency_key": "qa-mock-location-{{run_id}}",
        "client_revision": 1,
        "device_id": "qa-device-{{run_id}}",
        "location_assertion_id": "qa-location-mock-{{run_id}}"
      },
      "expected_status": 403,
      "expected_fields": {
        "accepted": false,
        "reject_reason": "mock_location",
        "balance_g": 995,
        "server_revision": 1,
        "audit_event_id": "$nonempty",
        "fraud_event_id": "$nonempty"
      }
    },
    {
      "id": "location_tampering_rejected",
      "category": "gps_fraud_detection",
      "method": "POST",
      "path": "/v1/bets",
      "headers": {
