{
  "name": "hiroshi-emdash-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "astro": "astro",
    "secrets:generate": "emdash secrets generate --write .env",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.1",
    "astro": "7.4.2",
    "emdash": "1.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
