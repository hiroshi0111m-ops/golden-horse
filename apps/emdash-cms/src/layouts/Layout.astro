---
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="EmDashで記事と画像を管理するAstroサイト" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | EmDash</title>
  </head>
  <body>
    <main><slot /></main>
    <style is:global>
      :root { color-scheme: dark; font-family: system-ui, sans-serif; color: #eef1f8; background: #111723; line-height: 1.8; }
      body { margin: 0; }
      main { max-width: 760px; padding: 72px 24px; margin: auto; }
      h1 { font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.3; letter-spacing: -.04em; margin: 12px 0 24px; }
      h2 { font-size: 1.15rem; }
      p, li { color: #bcc6d8; }
      a { color: #a8c7ff; text-underline-offset: 4px; }
      .eyebrow { color: #dcbd7b; font-size: .8rem; letter-spacing: .2em; }
      .actions { display: flex; flex-wrap: wrap; gap: 14px; margin: 32px 0; }
      .button { display: inline-block; padding: 12px 22px; border: 1px solid #48546a; border-radius: 12px; text-decoration: none; }
      .primary { background: #e0c58a; color: #151a22; border-color: #e0c58a; font-weight: 700; }
      .panel { padding: 24px; margin: 28px 0; border: 1px solid #344056; border-radius: 16px; background: #192231; }
      ul { padding-left: 24px; }
      footer { border-top: 1px solid #344056; padding-top: 24px; margin-top: 40px; font-size: .85rem; }
      a:focus-visible { outline: 3px solid #a8c7ff; outline-offset: 5px; }
      @media (max-width: 480px) { main { padding-top: 40px; } .actions a { flex-grow: 1; text-align: center; } }
    </style>
  </body>
</html>
